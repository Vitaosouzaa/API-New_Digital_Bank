# Ambiente
NODE_ENV=development

# Porta do servidor (apenas para desenvolvimento local)
PORT=5000

# JWT Secret (MUDE PARA UM VALOR SEGURO EM PRODUÇÃO!)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_123456789

# URL do Frontend (para configuração de CORS)
FRONTEND_URL=http://localhost:5173

# Database URL para produção (PostgreSQL, MySQL, etc)
# Exemplo PostgreSQL: postgresql://user:password@host:5432/database
# Exemplo MySQL: mysql://user:password@host:3306/database
DATABASE_URL=postgresql://user:password@host:5432/bancook
